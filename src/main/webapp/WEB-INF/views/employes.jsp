<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="header.jspf" %>
<div class="card"><h1>Employés</h1><form class="search" method="get"><input name="q" value="${param.q}" placeholder="Rechercher par code ou nom"><button class="btn">Rechercher</button><a class="btn secondary" href="${pageContext.request.contextPath}/employes">Réinitialiser</a><a class="btn" href="${pageContext.request.contextPath}/employes/new">+ Ajouter</a></form>
<table class="table"><tr><th>Code</th><th>Nom</th><th>Prénom</th><th>Poste</th><th>Actions</th></tr><c:forEach var="e" items="${employes}"><tr><td>${e.codeemp}</td><td>${e.nom}</td><td>${e.prenom}</td><td>${e.poste}</td><td class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/employes/edit?id=${e.codeemp}">Modifier</a><a class="btn danger" onclick="return confirm('Supprimer cet employé ?')" href="${pageContext.request.contextPath}/employes/delete?id=${e.codeemp}">Supprimer</a></td></tr></c:forEach></table></div><%@ include file="footer.jspf" %>
