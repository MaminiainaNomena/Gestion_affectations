<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="header.jspf" %><div class="card"><h1>Lieux</h1><p><a class="btn" href="${pageContext.request.contextPath}/lieux/new">+ Ajouter</a></p><table class="table"><tr><th>Code</th><th>Désignation</th><th>Province</th><th>Actions</th></tr><c:forEach var="l" items="${lieux}"><tr><td>${l.codelieu}</td><td>${l.designation}</td><td>${l.province}</td><td class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/lieux/edit?id=${l.codelieu}">Modifier</a><a class="btn danger" onclick="return confirm('Supprimer ce lieu ?')" href="${pageContext.request.contextPath}/lieux/delete?id=${l.codelieu}">Supprimer</a></td></tr></c:forEach></table></div><%@ include file="footer.jspf" %>
