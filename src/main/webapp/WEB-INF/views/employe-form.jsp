<%@ include file="header.jspf" %><div class="card"><h1>${empty employe ? 'Nouvel employé' : 'Modifier employé'}</h1><form method="post" action="${pageContext.request.contextPath}/employes"><input type="hidden" name="oldCode" value="${employe.codeemp}"><div class="form-grid"><label class="field">Code<input name="codeemp" required value="${employe.codeemp}"></label><label class="field">Nom<input name="nom" required value="${employe.nom}"></label><label class="field">Prénom<input name="prenom" required value="${employe.prenom}"></label><label class="field">Poste<input name="poste" required value="${employe.poste}"></label></div><br><button class="btn">Enregistrer</button> <a class="btn secondary" href="${pageContext.request.contextPath}/employes">Annuler</a></form></div><%@ include file="footer.jspf" %>
