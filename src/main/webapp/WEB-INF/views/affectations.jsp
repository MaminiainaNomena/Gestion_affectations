<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="header.jspf" %><div class="card"><h1>Affectations</h1><p><a class="btn" href="${pageContext.request.contextPath}/affectations/new">+ Nouvelle affectation</a></p><table class="table"><tr><th>Employé</th><th>Lieu</th><th>Province</th><th>Date</th><th>Actions</th></tr><c:forEach var="a" items="${affectations}"><tr><td>${a.employe.codeemp} — ${a.employe.nom} ${a.employe.prenom}</td><td>${a.lieu.designation}</td><td>${a.lieu.province}</td><td>${a.date}</td><td class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/affectations/edit?codeemp=${a.id.codeemp}&codelieu=${a.id.codelieu}">Modifier</a><a class="btn danger" onclick="return confirm('Supprimer cette affectation ?')" href="${pageContext.request.contextPath}/affectations/delete?codeemp=${a.id.codeemp}&codelieu=${a.id.codelieu}">Supprimer</a></td></tr></c:forEach></table></div><%@ include file="footer.jspf" %>
